# ==============================================================================
# EXPEDIÇÃO PIRAÍBA — CONFIGURAÇÃO DE PRODUÇÃO (VPS)
# ==============================================================================

# Segurança Django
DEBUG=false
SECRET_KEY=gerar-chave-secreta-forte-com-openssl-rand-hex-32
ALLOWED_HOSTS=piraiba.alvor.lat,alvor.lat,www.alvor.lat,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=https://piraiba.alvor.lat,https://alvor.lat,https://www.alvor.lat
CSRF_TRUSTED_ORIGINS=https://piraiba.alvor.lat,https://alvor.lat,https://www.alvor.lat

# Credenciais do Painel de Operações / Administrador
ADMIN_EMAIL=admin@expedicaopiraiba.com.br
ADMIN_PASSWORD=definir-senha-forte-para-o-painel-admin

# Banco de Dados PostgreSQL (Isolado no container Docker)
POSTGRES_DB=expedicao_piraiba
POSTGRES_USER=expedicao_piraiba
POSTGRES_PASSWORD=definir-senha-forte-para-o-banco-de-dados

# URL pública da API consumida pelo Frontend Next.js
NEXT_PUBLIC_API_URL=https://piraiba.alvor.lat/api
